<Application x:Class="NoctaliaWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- дефолтные значения палитры; ApplyConfig заменяет их на цвета из конфига -->
            <SolidColorBrush x:Key="TextColor"    Color="#FFF2F2F7"/>
            <SolidColorBrush x:Key="DimColor"     Color="#FF9A9AA8"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F21A1B26"/>
            <SolidColorBrush x:Key="OutlineBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="HoverBrush"   Color="#28FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
