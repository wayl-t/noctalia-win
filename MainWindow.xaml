<Window x:Class="NoctaliaWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoctaliaWin"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Height="60"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- индикатор рабочего стола -->
        <Style x:Key="WsDot" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Корневая рамка панели -->
    <Border x:Name="RootBorder"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
            Background="{Binding BackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
            BorderBrush="#22FFFFFF" BorderThickness="1"
            Margin="{Binding PanelMargin, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВО: рабочие столы + заголовок окна -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0">
                <!-- рабочие столы подставляются кодом -->
                <StackPanel x:Name="WorkspacesPanel" Orientation="Horizontal" Margin="0,0,6,0"/>

                <Border Width="1" Height="18" Background="#33FFFFFF" Margin="6,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="WindowTitleText" Style="{StaticResource DimText}"
                           MaxWidth="320" Margin="6,0,0,0"
                           ToolTip="Активное окно"/>
            </StackPanel>

            <!-- ЦЕНТР: часы -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ClockButton" Style="{StaticResource BarButton}" Click="Clock_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TimeText" Style="{StaticResource BarText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DateText" Style="{StaticResource DimText}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ПРАВО: статистика, батарея, громкость, настройки -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">

                <TextBlock x:Name="CpuText" Style="{StaticResource DimText}" Margin="0,0,10,0"
                           ToolTip="Загрузка CPU"/>
                <TextBlock x:Name="RamText" Style="{StaticResource DimText}" Margin="0,0,10,0"
                           ToolTip="Оперативная память"/>

                <StackPanel x:Name="BatteryBadge" Orientation="Horizontal" Margin="0,0,6,0"
                            Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryIcon" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BatteryText" Style="{StaticResource BarText}" Margin="4,0,0,0" FontSize="12"/>
                </StackPanel>

                <Button x:Name="VolumeButton" Style="{StaticResource BarButton}" Click="Volume_Click"
                        ToolTip="Громкость — клик, прокрутка — регулировка"
                        MouseWheel="Volume_Scroll">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VolumeIcon" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VolumeText" Style="{StaticResource BarText}" Margin="5,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickSettingsButton" Style="{StaticResource BarButton}" Click="QuickSettings_Click"
                        ToolTip="Быстрые настройки">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource TextColor}" Text="&#xE713;"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
