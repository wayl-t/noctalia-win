<Window x:Class="NoctaliaWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoctaliaWin"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Height="48"
        Width="1200"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- кнопка на панели; подсветка берётся из палитры темы (HoverBrush) -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- обёртка виджета: мягкая подсветка под курсором (как hover_highlight в Noctalia) -->
        <Style x:Key="WidgetBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- индикатор рабочего стола -->
        <Style x:Key="WsDot" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Корневая рамка панели: окно само по размеру полосы, док к краю экрана -->
    <Border x:Name="RootBorder"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
            Background="{Binding BackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
            Margin="0">
        <Grid Margin="{Binding BarPadding, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Три зоны, как start/center/end в Noctalia: виджеты расставляет ApplyLayout по конфигу -->
            <StackPanel x:Name="StartPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <Border x:Name="WorkspacesWidget" Style="{StaticResource WidgetBorder}">
                    <StackPanel x:Name="WorkspacesPanel" Orientation="Horizontal"/>
                </Border>

                <Border x:Name="TitleWidget" Style="{StaticResource WidgetBorder}" ToolTip="Активное окно">
                    <TextBlock x:Name="WindowTitleText" Style="{StaticResource DimText}" MaxWidth="320"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="CenterPanel" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="ClockButton" Style="{StaticResource BarButton}" Click="Clock_Click"
                        ToolTip="Календарь">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TimeText" Style="{StaticResource BarText}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DateText" Style="{StaticResource DimText}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="EndPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <Border x:Name="StatsWidget" Style="{StaticResource WidgetBorder}" ToolTip="Ресурсы системы">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CpuText" Style="{StaticResource DimText}"/>
                        <TextBlock x:Name="RamText" Style="{StaticResource DimText}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BatteryWidget" Style="{StaticResource WidgetBorder}" ToolTip="Батарея"
                        Visibility="Collapsed">
                    <StackPanel x:Name="BatteryBadge" Orientation="Horizontal">
                        <TextBlock x:Name="BatteryIcon" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BatteryText" Style="{StaticResource BarText}" Margin="4,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Button x:Name="VolumeButton" Style="{StaticResource BarButton}" Click="Volume_Click"
                        ToolTip="Громкость — клик, прокрутка — регулировка"
                        MouseWheel="Volume_Scroll">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VolumeIcon" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource TextColor}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VolumeText" Style="{StaticResource BarText}" Margin="5,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuickSettingsButton" Style="{StaticResource BarButton}" Click="QuickSettings_Click"
                        ToolTip="Быстрые настройки">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource TextColor}" Text="&#xE713;"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
