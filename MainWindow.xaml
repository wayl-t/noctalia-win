<Window x:Class="NoctaliaWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoctaliaWin"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Height="34"
        Width="1200"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Window.Resources>
        <!-- базовый текст панели; weight приходит из конфига (font_weight) -->
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource BarText}">
            <Setter Property="Foreground" Value="{DynamicResource DimColor}"/>
        </Style>

        <!-- иконка начертания Tabler (подставляется в FontFamily кодом) -->
        <Style x:Key="BarIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>

        <!-- кнопка на панели: подсветка берётся из роли hover палитры -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource WidgetRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- обёртка виджета: капсула + мягкая подсветка (capsule / hover_highlight) -->
        <Style x:Key="WidgetBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CapsuleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CapsuleBorderBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetRadius}"/>
            <Setter Property="Padding" Value="{DynamicResource CapsulePadding}"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- индикатор рабочего стола: пилюля с номером, как workspaces в Noctalia -->
        <Style x:Key="WsDot" TargetType="Border">
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetRadius}"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Корневая сетка: полоса во всю ширину окна, фон/обводка — на RootBorder -->
    <Grid x:Name="RootGrid">
        <Border x:Name="RootBorder"
                Background="{Binding BackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderBrush="{Binding BarBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderThickness="{Binding BarBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Три зоны, как start/center/end: виджеты расставляет ApplyLayout -->
                <StackPanel x:Name="StartPanel" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Stretch" Margin="{Binding StartPadding, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="Transparent" MouseRightButtonUp="StartPanel_RightClick"/>

                <StackPanel x:Name="CenterPanel" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                <StackPanel x:Name="EndPanel" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Stretch" Margin="{Binding EndPadding, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="Transparent" MouseRightButtonUp="EndPanel_RightClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
